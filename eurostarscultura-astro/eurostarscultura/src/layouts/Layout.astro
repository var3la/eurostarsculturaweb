---
import '../styles/global.css';
import Cookies from '../components/Cookies.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { title = 'Eurostars Arte y Cultura', description = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="shortcut icon" href="https://images.booking-channel.com//CLIENTES/www.eurostarshotels.com/images/cultura/favicon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com/" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Archivo:wght@300;400;500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <Cookies />
    <header><Nav /></header>
    <main><slot /></main>
    <Footer />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
