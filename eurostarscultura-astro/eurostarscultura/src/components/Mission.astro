---
const { number, label, title, paragraphs, images } = Astro.props;
---
<section class="mission" id="mission">
  <div class="mission-left">
    <p class="section-number"><span>{number}</span></p>
    <p class="section-label">{label}</p>
    <h2 class="mission-title">
      {title.map((t) => <span class="reveal-line"><span>{t}</span></span>)}
    </h2>
    <div class="mission-body">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
  <div class="mission-right">
    {images.map((src) => (
      <div class="mission-img"><img src={src} alt="" loading="lazy" /></div>
    ))}
  </div>
</section>
